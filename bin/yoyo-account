#!/usr/bin/env bash
#
# yoyo-account - sign a second Claude account in and print the configuration for it.
#
# Adding an account by hand is three remembered things: which directory that
# account's authentication goes in, the one-time login into it, and the entry to
# put in .yoyodyne/config.yaml. This asks them instead, in the same spirit as
# `yoyo setup` - remembered commands become asked questions.
#
# It changes exactly one thing on this machine: it creates the account's own
# provider home and runs the provider's login into it. It does not edit your
# configuration. What it prints at the end is the block to paste, because the
# configuration is yours and a script that edited it would be one more thing
# to trust.
#
# Read the warning it prints before the browser opens. The OAuth flow binds
# whichever Claude account that browser is signed in as, so signing a second
# account in from a browser already signed in as the first one silently gives
# you the first one twice.
#
# It reports nothing about which accounts exist or whether they are signed in.
# `yoyo doctor` answers that, from the configuration, an alias at a time, with
# the login to run for one that is not - and it is deliberately the only thing
# that answers it. A checker here would enumerate provider homes on disk rather
# than the accounts the project declares, so it would miss the configured alias
# nobody has signed in to yet, which is the exact state worth catching, and it
# would call a home left behind by a removed alias healthy. Two answers to one
# question is a disagreement only the operator can settle.
#
# Answers are read from standard input. At a terminal that is you typing; run
# with standard input redirected, the answers are taken from it, one per line,
# and the terminal is not prompted.
#
#   yoyo-account                     ask for everything
#   yoyo-account --alias personal    name the alias up front
#   yoyo doctor                      say whether each configured account is signed in

set -euo pipefail

usage() { awk 'NR==1{next} /^#/{sub(/^# ?/,""); print; next} {exit}' "$0"; }

alias_arg=""
pool_arg=""

while [ $# -gt 0 ]; do
  case "$1" in
    -h|--help) usage; exit 0 ;;
    --alias) alias_arg="${2:?--alias needs a value}"; shift 2 ;;
    --pool) pool_arg="${2:?--pool needs a value}"; shift 2 ;;
    --) shift; break ;;
    *) echo "unknown option: $1" >&2; usage >&2; exit 2 ;;
  esac
done

# Ask the binary where the machine home is rather than working it out here. The
# home can be moved by YOYODYNE_STATE_HOME, by state_root in the machine file,
# or by XDG_STATE_HOME, and falls back to the earlier builds' default until the
# migration moves it; a script that repeated any of that would, on a machine
# whose home moved, sign an account in where the harness never looks. `yoyo home
# --path` is the harness's own answer. YOYO names the binary to ask, for a
# machine that has more than one.
state_root() {
  local yoyo="${YOYO:-yoyo}"
  command -v "$yoyo" >/dev/null 2>&1 || {
    echo "$yoyo is not on PATH; this asks it where the harness keeps its accounts, so install it first (or name it with YOYO=/path/to/yoyo)" >&2
    exit 1
  }
  "$yoyo" home --path
}

root="$(state_root)" || exit 1
accounts="$root/accounts"

# Mirror config.AccountConfigDirectory: the default alias is wherever this
# machine is already signed in, and every other alias has a home of its own.
home_for() {
  case "$1" in
    default) printf '%s\n' "" ;;
    *) printf '%s\n' "$accounts/$1" ;;
  esac
}

command -v claude >/dev/null 2>&1 || {
  echo "claude is not on PATH; install it first: npm install -g @anthropic-ai/claude-code" >&2
  exit 1
}

ask() {
  local prompt="$1" default="$2" answer
  if [ -n "$default" ]; then
    read -r -p "$prompt [$default]: " answer || true
    printf '%s\n' "${answer:-$default}"
  else
    read -r -p "$prompt: " answer || true
    printf '%s\n' "$answer"
  fi
}

if [ -z "$alias_arg" ]; then
  echo "An alias is the name every run record and every surface says this account by."
  echo "It is yours to choose: lower-case letters, digits, and hyphens."
  alias_arg="$(ask "alias for the new account" "")"
fi
case "$alias_arg" in
  "") echo "an alias is required" >&2; exit 2 ;;
  default) echo "the alias \"default\" is the account this machine is already signed in as; choose another name" >&2; exit 2 ;;
  *[!a-z0-9-]*|-*|*-) echo "alias \"$alias_arg\" must be lower-case letters, digits, and hyphens, and must not start or end with one" >&2; exit 2 ;;
esac

if [ -z "$pool_arg" ]; then
  echo
  echo "An active account is round-robined with the other active ones, a run at a time."
  echo "A reserved account is served from only when no active account can be."
  pool_arg="$(ask "pool for $alias_arg (active/reserved)" "active")"
fi
case "$pool_arg" in
  active|reserved) ;;
  *) echo "pool must be \"active\" or \"reserved\"" >&2; exit 2 ;;
esac

echo
echo "A weekly budget stands this account down once the runs that named it have"
echo "cost that much over seven days. Leave it empty for no budget at all, which"
echo "means spend on it until the provider's own limit stops us."
budget="$(ask "weekly budget in USD for $alias_arg (empty for none)" "")"
if [ -n "$budget" ]; then
  case "$budget" in
    *[!0-9.]*|.|*.*.*) echo "a budget must be a number of dollars, or empty" >&2; exit 2 ;;
  esac
fi

home="$(home_for "$alias_arg")"

cat <<WARNING

  ------------------------------------------------------------------
  BEFORE YOU CONTINUE: open a NEW BROWSER PROFILE first.

  The login below opens an OAuth flow in your browser, and it binds
  whichever Claude account that browser is already signed in as. If you
  use the browser profile you signed the first account in with, you will
  sign this alias in as that same account and end up with one account
  under two names -- which looks exactly like a working pool until both
  halves of it run out of capacity at the same moment.

  Open a fresh profile (or a private window signed in as nobody), sign it
  in as the SECOND account, and leave it as the default browser for the
  next step.
  ------------------------------------------------------------------

WARNING

confirm="$(ask "ready to sign \"$alias_arg\" in? (yes/no)" "no")"
case "$confirm" in
  y|yes|Y|YES) ;;
  *) echo "nothing was changed."; exit 0 ;;
esac

mkdir -p "$home"
chmod 700 "$home"
echo
echo "signing in, with CLAUDE_CONFIG_DIR=$home"
# Whether the login took is the provider's own answer and then `yoyo doctor`'s.
# Nothing here re-decides it: a login that failed exits non-zero and stops this
# script under `set -e`, and a login that succeeded is confirmed by the one thing
# that reads the configuration to do it.
CLAUDE_CONFIG_DIR="$home" claude auth login

echo
echo "\"$alias_arg\" was signed in, in $home"

# Only the new entry is printed, and the existing mapping is left alone. This
# script does not read the configuration, so it does not know what the account
# already there is called -- a project whose single account is aliased "work"
# would be handed a "default" it never declared, and pasting that would make a
# three-account pool out of a two-account one.
cat <<CONFIG

Add this entry to the accounts mapping in .yoyodyne/config.yaml, alongside the
one that is already there -- whatever it is called -- rather than replacing it:

  $alias_arg:
    pool: $pool_arg
CONFIG
if [ -n "$budget" ]; then
  echo "    weekly_budget_usd: $budget"
fi
cat <<'NEXT'

Then check every configured account -- which is what says whether this one took,
and the only thing that answers it:

  yoyo doctor

It reports each alias the configuration declares, whether it is authenticated,
which half of the pool it is in, and the login to run for one that is not. Every
run from then on records the account it was served by, and `yoyo status` says it
back.
NEXT
